# Frontend production - copy to .env.production
# VITE_API_URL must point to your backend's public URL + /api/v1
# Example if backend is at https://api.yourdomain.com -> https://api.yourdomain.com/api/v1
VITE_API_URL=https://dexterauth.onrender.com/api/v1
# Google One Tap Client ID (same as backend GOOGLE_CLIENT_ID)
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
