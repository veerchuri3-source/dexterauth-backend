# --- DISCORD CREDENTIALS ---
# The bot user token from the Discord Developer Portal (Bot tab)
DISCORD_TOKEN=your_bot_token_here

# The application Client ID from the Discord Developer Portal (General Information tab)
DISCORD_CLIENT_ID=your_client_id_here

# Optional: Specific Discord Server/Guild ID to register slash commands instantly (highly recommended for local testing)
DISCORD_GUILD_ID=

# --- DEXTERAUTH BACKEND ENDPOINT ---
# URL pointing to the DexterAuth developer backend API
AUTH_API_URL=https://dexterauth.onrender.com/api/v1/dev

# --- HEALTH MONITORING PORT ---
BOT_HEALTH_PORT=3002
BOT_HEALTH_URL=https://discord.status.dexterauth.com/health
