# AuthLX Production - copy to .env.production and fill real values
# NEVER commit .env.production with real secrets

NODE_ENV=production
PORT=3000

# PostgreSQL - Neon is fine for production, or self-hosted VPS:
# Neon:      postgresql://neondb_owner:TOKEN@ep-xxx.aws.neon.tech/neondb?sslmode=require
# Self-host: postgresql://authlx:STRONG_PASSWORD@localhost:5432/authlx?sslmode=disable
DATABASE_URL=postgresql://neondb_owner:npg_W8jbMAHV3enY@ep-quiet-darkness-ax6tarom.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_96_HEX_CHARS_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# Your frontend domain(s) - comma separated. MUST be exact origin, no trailing slash.
# Example single domain: https://yourdomain.com
# Example multi: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=https://yourdomain.com
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=30000
RATE_LIMIT_MAX=30
CLIENT_RATE_LIMIT_MAX=120

# URLs used in emails / payment redirects
PUBLIC_BASE_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Payments - leave empty to run DEV MODE (instant activation, no charge)
# STRIPE_SECRET_KEY=sk_live_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx
RAZORPAY_KEY_ID=rzp_test_TS6HP5yX5kS3DP
RAZORPAY_KEY_SECRET=I7cdj8cXBXb6rzktlPPsoSFJ
# RAZORPAY_WEBHOOK_SECRET=whsec_from_razorpay_dashboard

MAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@yourdomain.com
# SMTP_PASS=change-me
# MAIL_FROM=AuthLX <no-reply@yourdomain.com>

# Google One Tap (get from console.cloud.google.com -> OAuth 2.0 Client ID -> Web application)
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=

# Discord OAuth (create at discord.com/developers/applications -> OAuth2)
# DISCORD_CLIENT_ID=123456789012345678
# DISCORD_CLIENT_SECRET=your_discord_client_secret
# DISCORD_REDIRECT_URI=https://dexterauth.onrender.com/api/v1/dev/auth/discord/callback
# DISCORD_BOT_TOKEN=  (optional, for bot features)

SEED_DEMO=0
UPLOADS_DIR=./uploads
