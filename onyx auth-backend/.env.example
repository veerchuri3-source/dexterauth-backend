# AuthLX backend configuration
# Copy to .env and adjust. NEVER commit real secrets.

NODE_ENV=production
PORT=3000

# PostgreSQL connection string.
# Local/self-hosted VPS example:
#   postgresql://authlx:STRONG_PASSWORD@localhost:5432/authlx?sslmode=disable
# Neon (serverless) example:
#   postgresql://neondb_owner:TOKEN@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/authlx?sslmode=disable

# Secret used to sign dashboard JWTs (use a long random string)
JWT_SECRET=generate-a-long-random-string-here
JWT_EXPIRES_IN=7d

# CORS - comma separated list, or * for all
CORS_ORIGINS=*
# Set to 1 when running behind a proxy/load balancer (Cloudflare, nginx, caddy)
TRUST_PROXY=1

# Rate limiting (production default: 30 req / 30s per IP, per spec)
RATE_LIMIT_WINDOW_MS=30000
RATE_LIMIT_MAX=30
CLIENT_RATE_LIMIT_MAX=120

# SMTP (leave disabled to print OTP codes to server logs in development)
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=change-me
MAIL_FROM=AuthLX <no-reply@example.com>

# Discord OAuth (optional)
DISCORD_CLIENT_ID=
DISCORD_REDIRECT_URI=

# Seed demo data on first boot (1 = yes)
SEED_DEMO=1

# Where uploaded release files are stored
UPLOADS_DIR=./uploads

# Public base URL used in payment redirects
PUBLIC_BASE_URL=http://localhost:3000